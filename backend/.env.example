# ==============================================================================
# DIGIT-B API – environment template.
# Copy to .env, run `php artisan key:generate`, then fill in the values.
# NEVER commit a real .env. Do not put production secrets in this file.
# ==============================================================================

# ---- Application -------------------------------------------------------------
APP_NAME=DIGIT-B
APP_ENV=local                 # local | staging | production
APP_KEY=                      # php artisan key:generate
APP_DEBUG=true                # MUST be false in production (no stack traces)
APP_URL=http://localhost:8000 # public URL of THIS API (used for URL generation)
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ---- Frontend / CORS / SPA auth (Laravel Sanctum, cookie based) ---------------
# Public URL of the React site. Used for sitemap.xml, robots.txt and e-mail links.
FRONTEND_URL=http://localhost:5173
# Origins allowed to call the API with credentials (comma separated, no trailing slash).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Hosts (with port) that receive stateful session cookies. Must include the SPA origin.
# Production example: digit-b.com,www.digit-b.com
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000,127.0.0.1:8000

# ---- Session ------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave empty in local dev (Vite proxy keeps everything same-origin).
# Production: share the cookie between site and API sub-domains, e.g. .digit-b.com
SESSION_DOMAIN=
# Production over HTTPS: true. SameSite "lax" works for same-site sub-domains.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# ---- Database (MySQL 8.x, utf8mb4) --------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=digit_b
DB_USERNAME=digit_b           # use a dedicated least-privilege user in production
DB_PASSWORD=

# ---- Cache / queue ------------------------------------------------------------
CACHE_STORE=database
# sync = send mail inline (simple, local). Production: database (+ queue worker, see README).
QUEUE_CONNECTION=sync

# ---- Mail ---------------------------------------------------------------------
# log = write mails to storage/logs (default). Production: smtp (or ses, postmark...).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@digit-b.com"
MAIL_FROM_NAME="${APP_NAME}"
# Inbox that receives "new application / inquiry" alerts. Falls back to ADMIN_EMAIL.
NOTIFICATION_EMAIL=

# ---- Seeded super-admin (php artisan db:seed) ----------------------------------
ADMIN_NAME="Site Administrator"
ADMIN_EMAIL=admin@digit-b.com
# Leave EMPTY to have the seeder generate a random password and print it once.
ADMIN_PASSWORD=

# ---- File storage -------------------------------------------------------------
# Résumés go to the PRIVATE disk (storage/app/private), images to the PUBLIC disk
# (storage/app/public, exposed via `php artisan storage:link` at /storage).
FILESYSTEM_DISK=local
RESUME_DISK=private
MEDIA_DISK=public

# ---- Logging ------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug               # production: warning or error

# ---- Other Laravel defaults -----------------------------------------------------
BROADCAST_CONNECTION=log
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
