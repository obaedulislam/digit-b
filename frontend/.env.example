# Frontend environment (Vite). Copy to `.env.local` — never commit real values.
# Only variables prefixed VITE_ are exposed to the browser: NEVER put secrets here.

# Dev only: where the Vite dev server proxies /api, /sanctum, /storage, /sitemap.xml, /robots.txt.
# Default is http://127.0.0.1:8001 (port 8000 is often taken on Windows by HTTP.sys/IIS).
# VITE_PROXY_TARGET=http://127.0.0.1:8001

# API base path. Leave the default for same-origin deployments (recommended: the web
# server proxies /api to Laravel, so the Sanctum session cookie stays first-party).
# VITE_API_BASE=/api/v1

# Public site origin used for canonical URLs, Open Graph tags and JSON-LD.
# Defaults to window.location.origin; set it explicitly for production builds.
# VITE_SITE_URL=https://digit-b.com
